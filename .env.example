# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Public URL and anon key (safe for browser/SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Service Role Key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================================
# ADMIN AUTHENTICATION & ACCESS CONTROL
# ============================================================================
# Comma-separated list of admin emails allowed in Supabase Auth
ADMIN_EMAILS=admin@vastrastudio.com

# Passcode for quick admin access (or local admin evaluation before Supabase setup)
ADMIN_PASSCODE=vastra2026

# ============================================================================
# AMAZON S3 / CLOUDFRONT CDN (GOOGLE DRIVE -> S3 SYNC)
# ============================================================================
# Base CDN domain used to resolve product_images.s3_key (e.g. SKU001/front.jpg)
NEXT_PUBLIC_CDN_BASE_URL=https://d111111abcdef8.cloudfront.net
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=sudha-sales-product-images
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ============================================================================
# GOOGLE DRIVE SYNCHRONIZATION SOURCE
# ============================================================================
# ID of your `Clothing Store` root folder in Google Drive containing `products.csv` and `SKU001/` folders
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-folder-id
# Option A: Google Cloud Service Account (Recommended for private Drive folders)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Option B: Google Drive API Key (For shared/readable Drive folders)
GOOGLE_DRIVE_API_KEY=your-google-drive-api-key
# Webhook / Cron secret for automated `/api/admin/sync` triggers
SYNC_WEBHOOK_SECRET=sudha-sync-secret

# ============================================================================
# RAZORPAY ONLINE PAYMENTS (UPI, CARDS, NETBANKING)
# ============================================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# ============================================================================
# STOREFRONT SETTINGS
# ============================================================================
NEXT_PUBLIC_STORE_NAME=SUDHA SALES
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
